//! Checksum calculation for file verification

use sha2::{Sha512, Digest};
use tokio::io::{AsyncRead, AsyncReadExt};
use crate::error::{CitadelError, Result};

/// Calculate SHA-512 checksum of a file
pub async fn calculate_checksum(path: &std::path::Path) -> Result<String> {
    let mut file = tokio::fs::File::open(path)
    .await
    .map_err(|e| CitadelError::FileNotFound(format!("Failed to open file: {}", e)))?;
    
    let mut hasher = Sha512::new();
    let mut buffer = vec![0u8; 8192];
    
    loop {
        let bytes_read = file.read(&mut buffer).await
            .map_err(|e| CitadelError::StorageError(format!("Failed to read file: {}", e)))?;
        
        if bytes_read == 0 {
            break;
        }
        
        hasher.update(&buffer[..bytes_read]);
    }
    
    let checksum = hasher.finalize();
    Ok(hex::encode(checksum))
}